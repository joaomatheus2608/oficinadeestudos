{
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    { "source": "/admin", "destination": "/admin/login.html", "permanent": false },
    { "source": "/admin/", "destination": "/admin/login.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/privacidade.html", "destination": "/public/privacidade.html" },
    { "source": "/privacidade", "destination": "/public/privacidade.html" },
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" }
  ]
}
